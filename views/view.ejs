
<div class="bg-gray-900 text-gray-100">
    <section class="relative pt-28 pb-8 overflow-hidden">
     
      <div class="absolute top-0 left-1/4 w-64 h-64 bg-indigo-500/5 rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-64 h-64 bg-purple-500/5 rounded-full filter blur-3xl"></div>
      
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="bg-gray-800/40 backdrop-blur-md border border-gray-700 rounded-2xl overflow-hidden shadow-xl">
          <div class="py-12 px-6 md:px-12 text-center">
            <div class="inline-block mb-6 relative">
              <div class="absolute -left-10 -top-8 text-indigo-500/20 text-6xl">
                <i class='bx bxs-file'></i>
              </div>
              <div class="absolute -right-10 -top-8 text-indigo-500/20 text-6xl transform scale-x-[-1]">
                <i class='bx bxs-file'></i>
              </div>
              <h1 class="text-4xl md:text-5xl font-bold text-gray-100 relative">
                Your Uploaded Files
              </h1>
            </div>
            <p class="mt-3 mb-6 text-gray-400 max-w-2xl mx-auto">
              Files are automatically removed after 24 hours for your privacy
            </p>
            
            <div class="flex flex-wrap justify-center gap-8 pt-4">
              <div class="flex items-center text-gray-300">
                <i class='bx bx-time text-indigo-400 text-xl mr-2'></i>
                <span>Auto-delete in 24h</span>
              </div>
              <div class="flex items-center text-gray-300">
                <i class='bx bx-lock-alt text-indigo-400 text-xl mr-2'></i>
                <span>End-to-end encrypted</span>
              </div>
              <div class="flex items-center text-gray-300">
                <i class='bx bx-link text-indigo-400 text-xl mr-2'></i>
                <span>Shareable links</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="max-w-5xl mx-auto">
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% files.forEach((file, index) => { %>
            <li class="file-item" style="animation-delay: <%= index * 0.1 %>s">
              <div class="bg-gray-800/60 backdrop-blur-sm rounded-lg overflow-hidden border border-gray-700 hover:border-indigo-500 transition-all duration-300 hover:shadow-lg hover:shadow-indigo-900/20">
                <div class="p-4">
                  <div class="aspect-w-16 aspect-h-9 mb-4">
                    <% const ext = file.split(".").pop().toLowerCase(); %>
                    <% let iconClass = 'bx bxs-file'; %>
                    <% let iconColor = 'text-indigo-400'; %>                        
                    <% if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-image'; %>
                        <% iconColor = 'text-green-400'; %>
                        <img src="<%= file %>" 
                        alt="<%= file %>" 
                        class="rounded-lg object-cover w-full h-48 bg-gray-700">
                 
                    <% } else if (['pdf'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-pdf'; %>
                        <% iconColor = 'text-red-400'; %>
                        <div class="p-2 rounded-lg bg-red-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-pdf text-8xl text-red-500'></i>
                        </div>
                    <% } else if (['doc', 'docx'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-doc'; %>
                        <% iconColor = 'text-blue-400'; %>
                        <div class="p-2 rounded-lg bg-blue-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-doc text-8xl text-blue-500'></i>
                        </div>
                    <% } else if (['xls', 'xlsx'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-excel'; %>
                        <% iconColor = 'text-green-500'; %>
                        <div class="p-2 rounded-lg bg-green-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-excel text-8xl text-green-500'></i>
                        </div>
                    <% } else if (['zip', 'rar', '7z'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-archive'; %>
                        <% iconColor = 'text-yellow-400'; %>
                        <div class="p-2 rounded-lg bg-yellow-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-archive text-8xl text-yellow-500'></i>
                        </div>
                    <% } else if (['mp3', 'wav', 'ogg', 'flac'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-audio'; %>
                        <% iconColor = 'text-pink-400'; %>
                        <div class="p-2 rounded-lg bg-pink-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-audio text-8xl text-pink-500'></i>
                        </div>
                    <% } else if (['mp4', 'mkv', 'avi', 'mov'].includes(ext)) { %>
                        <% iconClass = 'bx bxs-file-video'; %>
                        <% iconColor = 'text-yellow-400'; %>
                        <div class="p-2 rounded-lg bg-yellow-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file-video text-8xl text-yellow-500'></i>
                        </div>
                    <% } else{ %>
                        <% iconClass = 'bx bxs-file-doc'; %>
                        <% iconColor = 'text-blue-400'; %>
                        <div class="p-2 rounded-lg bg-purple-500/10 h-48 mr-3 flex items-center justify-center">   
                            <i class='bx bxs-file text-8xl text-purple-500'></i>
                        </div>
                    <% } %>



                    
                        </div>
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <div class="flex items-center">                      
                        
                        <i class='<%= iconClass %> <%= iconColor %> mr-2'></i>
                        <p class="text-sm text-gray-300 truncate">
                          <% const filename = file.split("."); %>
                          <%= file.substring(0, 5) + "***" + file.substring(filename[0].length - 3) %>
                        </p>
                      </div>
                      <div class="flex justify-between mt-2">
                        <p class="text-xs text-gray-500">
                          Click to download
                        </p>
                      </div>
                    </div>
                    <a href="/download/<%= file %>" 
                       class="inline-flex items-center justify-center p-3 bg-gray-700 rounded-lg hover:bg-indigo-600 transition-all duration-300 group">
                      <i class='bx bx-download text-xl text-gray-300 group-hover:text-white download-icon'></i>
                    </a>
                  </div>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
        
        <% if (files.length === 0) { %>
          <div class="text-center py-16 bg-gray-800/30 backdrop-blur-sm rounded-xl border border-gray-700 mt-8">
            <div class="relative">
              <div class="absolute inset-0 flex items-center justify-center opacity-10">
                <i class='bx bx-cloud-upload text-9xl text-indigo-500'></i>
              </div>
              <div class="relative z-10 p-8">
                <i class='bx bx-folder-open text-6xl text-gray-600 mb-4'></i>
                <h3 class="text-xl font-medium text-gray-400">No files uploaded yet</h3>
                <p class="text-gray-500 mt-2">Upload some files to see them here</p>
                <a href="/" class="inline-flex items-center px-6 py-3 mt-6 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-all duration-300 shadow-lg shadow-indigo-600/20">
                  <i class='bx bx-upload mr-2'></i>
                  Upload Files
                </a>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  
  <style>
    /* Animation for file items */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .file-item {
      animation: fadeInUp 0.5s ease-out forwards;
      opacity: 0;
    }
    
    /* Download icon animation */
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-3px); }
    }
    
    .download-icon {
      transition: all 0.3s;
    }
    
    .group:hover .download-icon {
      animation: bounce 0.6s infinite;
    }
  </style>



