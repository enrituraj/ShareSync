
<div class="bg-gray-900 text-gray-100">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-100">
                Your Uploaded Files
            </h1>
            <p class="mt-3 text-gray-400">
                Files are automatically removed after 24 hours for your privacy
            </p>
        </div>

        <!-- Files Grid -->
        <div class="max-w-5xl mx-auto">
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% files.forEach((file, index) => { %>
                    <li class="file-item" style="animation-delay: <%= index * 0.1 %>s">
                        <div class="bg-gray-800 rounded-lg overflow-hidden border border-gray-700 hover:border-indigo-500 transition-colors duration-200">
                            <div class="p-4">
                                <div class="aspect-w-16 aspect-h-9 mb-4">
                                    <img src="<%= file %>" 
                                         alt="<%= file %>" 
                                         class="rounded-lg object-cover w-full h-48 bg-gray-700">
                                </div>
                                <div class="flex items-center justify-between">
                                    <div class="flex-1">
                                        <p class="text-sm text-gray-300 truncate">
                                            <% const ext = file.split("."); %>
                                            <%= file.substring(0, 5) + "***" + file.substring(ext[0].length - 3) %>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-1">
                                            Click to download
                                        </p>
                                    </div>
                                    <a href="/download/<%= file %>" 
                                       class="inline-flex items-center justify-center p-3 bg-gray-700 rounded-lg hover:bg-indigo-600 transition-colors duration-200 group">
                                        <i class='bx bx-download text-xl text-gray-300 group-hover:text-white download-icon'></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                <% }); %>
            </ul>

            <% if (files.length === 0) { %>
                <div class="text-center py-16">
                    <i class='bx bx-folder-open text-6xl text-gray-600 mb-4'></i>
                    <h3 class="text-xl font-medium text-gray-400">No files uploaded yet</h3>
                    <p class="text-gray-500 mt-2">Upload some files to see them here</p>
                    <a href="/" class="inline-flex items-center px-4 py-2 mt-4 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 transition duration-150">
                        <i class='bx bx-upload mr-2'></i>
                        Upload Files
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>