
<div class="bg-gray-900 text-gray-100 min-h-screen">
    

    <div id="login-page" class="min-h-screen flex items-center justify-center pt-16 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900">
        <div class="max-w-md w-full mx-auto p-6">
            <div class="auth-form bg-gray-800/50 backdrop-blur-md p-8 rounded-2xl border border-gray-700">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold mb-2">Welcome Back</h2>
                    <p class="text-gray-400">Sign in to your account</p>
                </div>

                <form action="/login" method="POST" class="space-y-6">
                    <div class="space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-envelope text-gray-400 mr-3'></i>
                                <input type="email" id="email" name="email" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Enter your email">
                            </div>
                        </div>

                        <div>
                            <label for="password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-lock-alt text-gray-400 mr-3'></i>
                                <input type="password" id="password" name="password" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Enter your password">
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center">
                            <input type="checkbox" id="remember" name="remember" 
                                   class="h-4 w-4 rounded border-gray-600 text-indigo-600 focus:ring-indigo-500 bg-gray-700">
                            <label for="remember" class="ml-2 text-gray-400">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" 
                            class="w-full flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                        <i class='bx bx-log-in mr-2'></i>
                        Sign In
                    </button>

                    <p class="text-center text-sm text-gray-400">
                        Don't have an account? 
                        <a href="/signup" class="text-indigo-400 hover:text-indigo-300 font-medium">Sign up</a>
                    </p>
                </form>
            </div>
        </div>
    </div>

</div>