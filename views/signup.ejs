<div class="bg-gray-900 text-gray-100 min-h-screen">
    
    <div id="signup-page" class="min-h-screen flex items-center justify-center pt-16 bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900">
        <div class="max-w-md w-full mx-auto p-6">
            <div class="auth-form bg-gray-800/50 backdrop-blur-md p-8 rounded-2xl border border-gray-700">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold mb-2">Create Account</h2>
                    <p class="text-gray-400">Join ShareSync today</p>
                </div>

                <form action="/signup" method="POST" class="space-y-6">
                    <div class="space-y-4">
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Full Name</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-user text-gray-400 mr-3'></i>
                                <input type="text" id="name" name="name" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Enter your full name">
                            </div>
                        </div>

                        <div>
                            <label for="signup-email" class="block text-sm font-medium text-gray-300 mb-2">Email</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-envelope text-gray-400 mr-3'></i>
                                <input type="email" id="signup-email" name="email" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Enter your email">
                            </div>
                        </div>

                        <div>
                            <label for="signup-password" class="block text-sm font-medium text-gray-300 mb-2">Password</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-lock-alt text-gray-400 mr-3'></i>
                                <input type="password" id="signup-password" name="password" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Create a password">
                            </div>
                        </div>

                        <div>
                            <label for="confirm-password" class="block text-sm font-medium text-gray-300 mb-2">Confirm Password</label>
                            <div class="input-group flex items-center bg-gray-700/50 border border-gray-600 rounded-lg px-4 py-3 focus-within:border-indigo-500 transition-colors duration-200">
                                <i class='bx bx-lock-alt text-gray-400 mr-3'></i>
                                <input type="password" id="confirm-password" name="confirm_password" required 
                                       class="bg-transparent w-full text-gray-100 placeholder-gray-400 focus:outline-none"
                                       placeholder="Confirm your password">
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center">
                        <input type="checkbox" id="terms" name="terms" required 
                               class="h-4 w-4 rounded border-gray-600 text-indigo-600 focus:ring-indigo-500 bg-gray-700">
                        <label for="terms" class="ml-2 text-sm text-gray-400">
                            I agree to the 
                            <a href="/terms" class="text-indigo-400 hover:text-indigo-300">Terms of Service</a> and 
                            <a href="/privacy" class="text-indigo-400 hover:text-indigo-300">Privacy Policy</a>
                        </label>
                    </div>

                    <button type="submit" 
                            class="w-full flex items-center justify-center px-4 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                        <i class='bx bx-user-plus mr-2'></i>
                        Create Account
                    </button>

                    <p class="text-center text-sm text-gray-400">
                        Already have an account? 
                        <a href="/login" class="text-indigo-400 hover:text-indigo-300 font-medium">Sign in</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>